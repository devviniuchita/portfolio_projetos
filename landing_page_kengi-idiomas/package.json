{
  "name": "kengi-idiomas",
  "version": "1.0.0",
  "description": "Landing Page para Kengi Idiomas com sistema de agenda e pagamentos",
  "scripts": {
    "dev": "concurrently \"http-server ./ -p 3000\" \"dotnet run --project backend/KengiIdiomas.Api\"",
    "proxy": "http-server ./ -p 3000 --proxy http://localhost:5000",
    "start": "http-server ./ -p 3000",
    "build:css": "postcss assets/CSS/global/global.css -o assets/CSS/global/output.css --watch",
    "lint": "eslint assets/js/**/*.js",
    "clean": "rimraf dist",
    "migrations": "bash .manus/scripts/setup_migrations.sh",
    "unificar": "bash .manus/scripts/unificar_entidades.sh"
  },
  "author": "Kengi Idiomas",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.3",
    "jwt-decode": "^4.0.0",
    "sweetalert2": "^11.10.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "http-server": "^14.1.1",
    "postcss": "^8.4.29",
    "postcss-cli": "^10.1.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.3"
  }
}
